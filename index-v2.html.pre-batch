<script src="portal/backend-url.js"></script>
<!-- STUDENT SIGN-IN, ON THIS PAGE. Every "Student Login" link used to be a
     trip to the portal's own login screen; now it opens the same sign-in as
     a dialog here, and only a signed-in student is actually sent to
     /portal. This is the portal's own auth-client.js, loaded in modal mode
     (see MODAL in that file) -- it paints nothing and wraps nothing until a
     link below is clicked. The session it writes is localStorage on this
     origin, which is exactly where the portal looks for it, so the student
     lands there already signed in. -->
<script>window.MORETTI_AUTH_MODE = 'modal';</script>
<script src="portal/auth-client.js"></script>
<script>
(function () {
  var PORTAL = 'portal/index.html';
  document.addEventListener('click', function (e) {
    if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    var a = e.target && e.target.closest ? e.target.closest('a[href="' + PORTAL + '"]') : null;
    if (!a) return;
    // auth-client.js blocked or failed to load: leave the link alone, so the
    // worst case is the old behaviour rather than a dead button.
    if (!window.MorettiAuth) return;
    e.preventDefault();
    // Already signed in on this device -- no reason to ask again; the portal
    // resumes the session on arrival.
    if (window.MorettiAuth.hasSession()) { window.location.href = PORTAL; return; }
    open();
  });

  function open() {
    window.MorettiAuth.openSignIn({
      onStudent: function () { window.location.href = PORTAL; }
    });
  }

  /* #signin opens it on arrival -- what portal-login-v2.html (the retired
     standalone sign-in page) now redirects to, and a link anyone can send. */
  function openFromHash() {
    if (location.hash !== '#signin' || !window.MorettiAuth) return;
    if (window.MorettiAuth.hasSession()) { window.location.href = PORTAL; return; }
    open();
  }
  window.addEventListener('hashchange', openFromHash);
  openFromHash();
})();
</script>
<script>
document.documentElement.classList.add('js');
function mtaSafe(fn){ try{ fn(); }catch(err){ if(window.console) console.error('[moretti]',err); } }

/* ── reveals: armed first; content stays visible if anything fails ── */
mtaSafe(function(){
  var root=document.documentElement, els=[].slice.call(document.querySelectorAll('.rv'));
  if(!els.length || !('IntersectionObserver' in window)) return;
  root.classList.add('anim');
  function show(e){e.classList.add('in');}
  var io=new IntersectionObserver(function(en){
    en.forEach(function(x){ if(x.isIntersecting){show(x.target);io.unobserve(x.target);} });
  },{rootMargin:'0px 0px -8% 0px',threshold:.08});
  els.forEach(function(e){
    if(e.getBoundingClientRect().top < window.innerHeight*0.95) show(e); else io.observe(e);
  });
  window.addEventListener('load',function(){
    els.forEach(function(e){ if(e.getBoundingClientRect().top<window.innerHeight) show(e); });
  });
  setTimeout(function(){ els.forEach(show); },4000);
});


/* ── reinstatement alert: shown once per visitor per day ── */
mtaSafe(function(){
  var ALERT_ENABLED=false;                 // muted — flip to true to bring the pop-up back
  var m=document.getElementById('alertModal'); if(!m) return;
  if(!ALERT_ENABLED){ m.hidden=true; document.body.style.overflow=''; return; }
  var KEY='mta_alert_seen', now=Date.now(), DAY=864e5, seen=0;
  try{ seen=+(localStorage.getItem(KEY)||0); }catch(e){}
  function close(){
    m.hidden=true;
    document.body.style.overflow='';
    try{ localStorage.setItem(KEY,String(Date.now())); }catch(e){}
  }
  function open(){
    m.hidden=false;
    document.body.style.overflow='hidden';
    var f=m.querySelector('.modal-x'); if(f) f.focus();
  }
  m.addEventListener('click',function(e){ if(e.target.closest('[data-close]')) close(); });
  document.addEventListener('keydown',function(e){ if(e.key==='Escape'&&!m.hidden) close(); });
  if(now-seen>DAY) setTimeout(open,700);
});

/* ── hero crosshair: eases toward the cursor instead of snapping to it ── */
mtaSafe(function(){
  var hero=document.querySelector('.hero'), x=document.getElementById('xhair');
  if(!hero||!x) return;
  if(window.matchMedia('(hover:none)').matches) return;
  if(window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  var h=x.querySelector('.xh'), v=x.querySelector('.xv'), d=x.querySelector('.xdot');
  var tx=0,ty=0,cx=0,cy=0,on=false,raf=0;
  function loop(){
    cx+=(tx-cx)*0.035; cy+=(ty-cy)*0.035;
    h.style.transform='translateY('+(cy-0.5)+'px)';
    v.style.transform='translateX('+(cx-0.5)+'px)';
    d.style.transform='translate('+cx+'px,'+cy+'px)';
    if(Math.abs(tx-cx)>0.25||Math.abs(ty-cy)>0.25){ raf=requestAnimationFrame(loop); } else { raf=0; }
  }
  hero.addEventListener('pointermove',function(e){
    var r=hero.getBoundingClientRect();
    tx=e.clientX-r.left; ty=e.clientY-r.top;
    if(!on){ on=true; cx=tx; cy=ty; x.classList.add('live'); }
    if(!raf) raf=requestAnimationFrame(loop);
  },{passive:true});
  hero.addEventListener('pointerleave',function(){ on=false; x.classList.remove('live'); },{passive:true});
});

/* ── top bar: flush over the hero, red once the hero is behind you ── */
mtaSafe(function(){
  var nav=document.querySelector('nav'); if(!nav) return;
  var hero=document.querySelector('.hero');
  function apply(){
    var y=window.pageYOffset||document.documentElement.scrollTop||0;
    var edge=hero?Math.max(80,hero.offsetHeight-nav.offsetHeight-40):120;
    nav.classList.toggle('at-top', y<40);
    nav.classList.toggle('is-red', y>=edge);
  }
  var tick=false;
  addEventListener('scroll',function(){
    if(tick) return; tick=true;
    requestAnimationFrame(function(){ apply(); tick=false; });
  },{passive:true});
  addEventListener('resize',apply,{passive:true});
  apply();
});

/* ── gold ticker ── */
mtaSafe(function(){
  var items=['Scored a <b>1520</b>','<b>+200</b> points SAT Math','<b>C</b> to an <b>A</b> in math','<b>+140</b> points, math','<b>D</b> to a <b>B</b>, finals passed','1500+ SAT instructor','Northwestern statistics','8+ years teaching','Score guarantee in writing'];
  var t=document.getElementById('tick'); if(!t) return;
  var h='';
  for(var p=0;p<2;p++) for(var i=0;i<items.length;i++)
    h+='<span class="tickeritem">'+items[i]+'</span><span class="tickersep">&#9670;</span>';
  t.innerHTML=h;
});


/* ── testimonial carousel: CarouselNavigator behaviour ── */
mtaSafe(function(){
  var data=[
    {q:'My daughter has gone from a <span class="tgain">C</span> to an <span class="tgain">A</span> grade student in math. I truly can&rsquo;t say enough praise for Luca. He is calm, sensitive, and able to customize his tutoring to achieve the needed learning. My daughter now feels confident in math and proud of her accomplishments.',a:'Patti M., parent'},
    {q:'She improved her SAT Math score by approximately <span class="tgain">200 points</span>, exceeding our expectations. One of Luca&rsquo;s greatest strengths is his ability to quickly identify a student&rsquo;s knowledge gaps and develop a structured, personalized lesson plan. He was always professional, punctual, and prepared for every session.',a:'Michele C., parent'},
    {q:'If anyone can help you tolerate math and actually master the skill, it&rsquo;s Luca! He took the time to break down the underlying concepts, never moving on until he was certain I fully understood. Thanks to Luca, I went from a student who was barely passing with a <span class="tgain">D</span> to someone who actually enjoys math.',a:'A student'},
    {q:'They went into test day feeling confident and <span class="tgain">scored a 1520</span>! Luca&rsquo;s tutoring was incredibly engaging and completely transformed how my child approached studying. I cannot recommend it enough to any parent looking to help their child succeed.',a:'Jessie C., parent'}
  ];
  var wrap=document.getElementById('slides'), ind=document.getElementById('dots');
  if(!wrap||!ind) return;
  wrap.innerHTML=''; ind.innerHTML='';
  var AUTO=6000, i=0, timer=null,
      reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  data.forEach(function(d,n){
    var sl=document.createElement('div');
    sl.className='slide'+(n===0?' on':'');
    sl.innerHTML='<blockquote>&ldquo;'+d.q+'&rdquo;</blockquote><div class="attr">'+d.a+'</div>';
    wrap.appendChild(sl);
    var b=document.createElement('button');
    b.type='button'; b.className='ind'+(n===0?' on':'');
    b.setAttribute('aria-label','Testimonial '+(n+1));
    b.innerHTML='<i></i>';
    b.addEventListener('click',function(){go(n);});
    ind.appendChild(b);
  });
  var slides=wrap.querySelectorAll('.slide'), dots=ind.querySelectorAll('.ind'),
      prev=document.getElementById('prev'), next=document.getElementById('next');

  function fill(){
    var bar=dots[i].querySelector('i');
    bar.classList.remove('run'); void bar.offsetWidth;
    bar.style.animationDuration=(AUTO/1000)+'s';
    if(!reduce) bar.classList.add('run');
  }
  function go(n){
    slides[i].classList.remove('on');
    dots[i].classList.remove('on');
    dots[i].querySelector('i').classList.remove('run');
    i=(n+data.length)%data.length;
    slides[i].classList.add('on');
    dots[i].classList.add('on');
    if(prev) prev.disabled=(i===0);
    fill(); restart();
  }
  function restart(){
    if(timer) clearTimeout(timer);
    if(!reduce) timer=setTimeout(function(){go(i+1);},AUTO);
  }
  if(prev) prev.addEventListener('click',function(){go(i-1);});
  if(next) next.addEventListener('click',function(){go(i+1);});
  var car=document.getElementById('car');
  if(car){
    car.addEventListener('mouseenter',function(){AUTO=15000;fill();restart();});
    car.addEventListener('mouseleave',function(){AUTO=6000;fill();restart();});
  }
  if(prev) prev.disabled=true;
  fill(); restart();
});

/* ── count-up: fires only when the strip is actually on screen,
      and decelerates hard into the final value ── */
mtaSafe(function(){
  var reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var cells=[].slice.call(document.querySelectorAll('[data-count]'));
  if(!cells.length) return;
  function run(el){
    if(el.dataset.done) return;
    el.dataset.done='1';
    var wait=+(el.getAttribute('data-delay')||0);
    if(wait){ setTimeout(function(){ el.removeAttribute('data-delay'); el.dataset.done=''; run(el); }, wait); return; }
    var to=+el.getAttribute('data-count'), from=+(el.getAttribute('data-from')||0);
    if(reduce){ el.textContent=to; return; }
    var t0=null, dur=2400;
    function step(ts){
      if(!t0)t0=ts;
      var k=Math.min(1,(ts-t0)/dur);
      var e=1-Math.pow(1-k,6);                 // quintic-plus ease-out: crawls at the end
      el.textContent=Math.round(from+(to-from)*e);
      if(k<1) requestAnimationFrame(step); else el.textContent=to;
    }
    requestAnimationFrame(step);
  }
  if(!('IntersectionObserver' in window)){ cells.forEach(run); return; }
  var io=new IntersectionObserver(function(en){
    en.forEach(function(x){ if(x.isIntersecting && x.intersectionRatio>=0.6){ run(x.target); io.unobserve(x.target); } });
  },{threshold:[0,0.6,1]});
  cells.forEach(function(c){ io.observe(c); });
});

mtaSafe(function(){
/* reserve form — same behaviour as the live site (honeypot, timing gate, Apps Script) ── */
  var LEAD_BACKEND_URL = window.APPS_SCRIPT_URL;   // portal/backend-url.js
  var readyAt = Date.now();
  var form = document.getElementById('reserve-form');
  if (!form) return;
  form.addEventListener('submit', function (e) {
    e.preventDefault();
    var name  = document.getElementById('rf-name').value.trim();
    var phone = document.getElementById('rf-phone').value.trim();
    var email = document.getElementById('rf-email').value.trim();
    var role  = (form.querySelector('input[name="role"]:checked') || {}).value || '';
    var grade = document.getElementById('rf-grade').value;
    var topic = document.getElementById('rf-topic').value;
    var message = document.getElementById('rf-message').value.trim();
    if (!name || !phone || !email || !role || !grade || !topic) { alert('Please fill in every field.'); return; }

    var honeypot = document.getElementById('rf-hp').value;
    var elapsedMs = Date.now() - readyAt;
    // Autofill can stamp the honeypot at the same moment it fills the real
    // fields. If the browser says the field was autofilled, don't hold it
    // against a real visitor.
    if (honeypot) {
      var hpEl = document.getElementById('rf-hp');
      [':autofill', ':-webkit-autofill'].forEach(function (sel) {
        try { if (hpEl.matches(sel)) honeypot = ''; } catch (err) {}
      });
    }
    var note = document.getElementById('rf-note'),
        ok   = document.getElementById('rf-success'),
        bad  = document.getElementById('rf-error'),
        btn  = document.getElementById('rf-submit');

    // Tripped honeypot or an implausibly fast submit reads as a bot —
    // show success and skip the network call, so it has no signal to adapt to.
    if (honeypot || elapsedMs < 2500) {
      note.style.display='none'; ok.style.display='block'; bad.style.display='none';
      form.reset(); return;
    }
    btn.disabled = true; btn.textContent = 'Sending…';
    fetch(LEAD_BACKEND_URL, {
      method: 'POST',
      body: JSON.stringify({ action:'submitLead', name:name, phone:phone, email:email, role:role, grade:grade, topic:topic, message:message, hp:honeypot, elapsedMs:elapsedMs })
    }).then(function(res){ return res.json(); })
      .then(function(data){
        if (!data || !data.ok) throw new Error('submit_failed');
        note.style.display='none'; ok.style.display='block'; bad.style.display='none';
        form.reset();
        btn.disabled=false; btn.textContent='Reserve My Seat';
      })
      .catch(function(){
        bad.style.display='block'; ok.style.display='none';
        btn.disabled=false; btn.textContent='Reserve My Seat';
      });
  });
});
</script>
</body>
</html>
