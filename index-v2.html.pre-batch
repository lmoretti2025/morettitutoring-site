  <div class="bookcard rv d2">
    <form id="reserve-form" novalidate>
      <div class="hp-field" aria-hidden="true">
        <label for="rf-hp">Leave this field blank</label>
        <input type="text" id="rf-hp" name="rf_x7q2" tabindex="-1" autocomplete="off" data-lpignore="true" data-1p-ignore data-form-type="other">
      </div>
      <div class="ff"><label class="fl" for="rf-name">Parent Name</label><input class="fi" type="text" id="rf-name" name="parentName" required></div>
      <div class="frow">
        <div class="ff"><label class="fl" for="rf-phone">Best Phone Number</label><input class="fi" type="tel" id="rf-phone" name="phone" placeholder="e.g. (201) 555-0100" required></div>
        <div class="ff"><label class="fl" for="rf-email">Best Email Address</label><input class="fi" type="email" id="rf-email" name="email" required></div>
      </div>
      <div class="ff">
        <span class="fl">Are you a parent or a student?</span>
        <div class="fradio">
          <label><input type="radio" name="role" value="Parent" required> Parent</label>
          <label><input type="radio" name="role" value="Student"> Student</label>
        </div>
      </div>
      <div class="frow">
        <div class="ff"><label class="fl" for="rf-grade">What grade is your child in?</label>
          <select class="fi" id="rf-grade" name="grade" required>
            <option value="">Select a grade</option><option value="9th or below">9th or below</option><option value="10th">10th</option><option value="11th">11th</option><option value="12th">12th</option>
          </select></div>
        <div class="ff"><label class="fl" for="rf-topic">What do you need help with?</label>
          <select class="fi" id="rf-topic" name="topic" required>
            <option value="">Select a topic</option><option value="SAT Prep">SAT Prep</option><option value="Mathematics">Mathematics</option><option value="College Admissions &amp; Essays">College Admissions &amp; Essays</option><option value="Something else / Not sure yet">Something else / Not sure yet</option>
          </select></div>
      </div>
      <div class="ff"><label class="fl" for="rf-message">Your Message <em>(optional)</em></label>
        <textarea class="fi" id="rf-message" name="message" rows="3" placeholder="Tell us about your student &mdash; current scores, goals, timeline, or anything else we should know."></textarea></div>
      <button type="submit" class="fsub" id="rf-submit">Reserve My Seat</button>
      <p class="fnote" id="rf-note">We&rsquo;ll get back to you within 24 hours.</p>
      <p id="rf-success" class="fmsg ok">Thanks &mdash; check your email for confirmation. We&rsquo;ll follow up personally within 24 hours.</p>
      <p id="rf-error" class="fmsg err">Something went wrong. Please call (201) 275-2791 directly.</p>
    </form>
  </div>
</div></section>

