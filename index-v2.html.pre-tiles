<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Moretti Test Prep &amp; Tutoring — SAT, Math &amp; College Admissions | Cranford, NJ</title>
<meta name="description" content="One-on-one preparation in mathematics, the SAT, and college admissions in Cranford, NJ and online. From Algebra 1 through Multivariable Calculus, taught by one instructor and backed by a guarantee: if the score doesn't improve, we keep teaching free.">
<meta property="og:title" content="Moretti Test Prep &amp; Tutoring">
<meta property="og:description" content="The standard your student is actually capable of. One-on-one preparation in mathematics, the SAT, and college admissions — taught by one instructor, to one standard.">
<meta property="og:type" content="website">
<meta property="og:url" content="https://morettitutoring.com/">
<meta property="og:image" content="https://morettitutoring.com/logo-caladea-dark.png">
<link rel="icon" type="image/png" sizes="512x512" href="target-icon-white.png">
<link rel="icon" href="favicon.ico" sizes="16x16 32x32 48x48">
<link rel="apple-touch-icon" href="apple-touch-icon.png">
<link rel="canonical" href="https://morettitutoring.com/">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Caladea:wght@400;700&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"EducationalOrganization","name":"Moretti Test Prep & Tutoring","url":"https://morettitutoring.com/","telephone":"+1-201-275-2791","address":{"@type":"PostalAddress","addressLocality":"Cranford","addressRegion":"NJ","addressCountry":"US"},"founder":{"@type":"Person","name":"Luca Moretti","alumniOf":"Northwestern University"},"areaServed":["Cranford NJ","Westfield NJ","Mountainside NJ","Scotch Plains NJ","Summit NJ","Short Hills NJ","New Providence NJ","Berkeley Heights NJ","Online — United States"]}
</script>
<style>
:root{
  --void:#0C0A09; --void-2:#171312;
  --paper:#FFFFFF; --surface:#FFFFFF; --sunk:#F4F4F3;
  --ink:#111111; --body:#4A4139; --muted:#8B8177;
  --line:rgba(17,17,17,.12); --hair:rgba(17,17,17,.065);
  --red:#B0271C; --red-lift:#D24234; --gold:#C9A84C; --gold-deep:#9A7C22;
  --display:'Caladea',Georgia,'Times New Roman',serif;
  --sans:'Poppins','Helvetica Neue',Helvetica,Arial,sans-serif;
  --gut:clamp(1.25rem,5vw,4.5rem);
  --ease:cubic-bezier(.22,1,.36,1);
  --spring:cubic-bezier(.34,1.4,.64,1);
  --springy:cubic-bezier(.16,1.2,.3,1);
}
*,*::before,*::after{box-sizing:border-box}
@keyframes pageIn{from{opacity:0}to{opacity:1}}
@media(prefers-reduced-motion:reduce){body{animation:none}}
html{scroll-behavior:smooth}
body{margin:0;animation:pageIn 1.05s var(--ease) both;background:var(--paper);color:var(--body);font-family:var(--sans);font-weight:300;line-height:1.62;-webkit-font-smoothing:antialiased;overflow-x:hidden}
a{color:inherit;text-decoration:none}
img{max-width:100%;display:block}
:focus-visible{outline:2px solid var(--red);outline-offset:3px}
h1,h2,h3,h4{margin:0;color:var(--ink);text-wrap:balance}
p{margin:0}
.shell{max-width:1220px;margin:0 auto;padding:0 var(--gut)}
.lbl{font-size:.61rem;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:var(--muted)}
.lbl::before,.eyeb::before{content:'\25C6';color:var(--red);margin-right:.55em;font-size:.85em;letter-spacing:0;vertical-align:.04em}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;padding:1.02rem 1.85rem;font-size:.76rem;font-weight:600;letter-spacing:.11em;text-transform:uppercase;transition:background .22s var(--ease),color .22s,border-color .22s,transform .22s var(--ease);cursor:pointer;border-radius:2px}
.btn-a{background:var(--ink);color:#fff}.btn-a:hover{background:var(--red);transform:translateY(-1px)}
.btn-b{border:1px solid var(--line);color:var(--ink);background:transparent}.btn-b:hover{border-color:var(--ink);transform:translateY(-1px)}

/* ── reveal (safe: visible unless JS enables) ── */
.js.anim .rv{opacity:0;transform:translateY(16px);filter:blur(3px)}
.js.anim .rv.in{opacity:1;transform:none;filter:none;transition:opacity .85s var(--ease),transform .85s var(--ease),filter .85s var(--ease)}
.js.anim .rv.d1.in{transition-delay:.08s}.js.anim .rv.d2.in{transition-delay:.16s}.js.anim .rv.d3.in{transition-delay:.24s}.js.anim .rv.d4.in{transition-delay:.32s}

/* ── NEWS BAR ── */
.newsbar{background:var(--void);color:#EDE7E5;font-size:.775rem}
.newsbar .shell{display:flex;gap:.8rem;align-items:center;justify-content:center;padding:.68rem var(--gut);flex-wrap:wrap;text-align:center}
.newsbar b{color:#fff;font-weight:600}
.newsbar .dot{width:5px;height:5px;border-radius:50%;background:var(--red-lift);flex:none;animation:pulse 2.6s ease-in-out infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.35}}
.newsbar a{color:#fff;border-bottom:1px solid rgba(255,255,255,.38);white-space:nowrap;transition:border-color .2s}
.newsbar a:hover{border-bottom-color:#fff}

/* ── NAV ── */
/* Base is solid black so the bar is legible even if the script never runs.
   .at-top makes it flush with the hero; .is-red is the scrolled state. */
nav{background:var(--void);border-bottom:1px solid rgba(255,255,255,.07);position:fixed;top:0;left:0;right:0;z-index:60;
  transition:background .55s var(--ease),border-color .55s var(--ease)}
/* the bar overlays the hero, so the hero clears it with padding rather than a spacer */

nav.at-top{background:transparent;border-bottom-color:transparent}
nav.is-red{background:var(--red);border-bottom-color:rgba(255,255,255,.16)}
nav.is-red .navlinks a:hover{color:#fff}
nav.is-red .navlinks a::after{background:#fff}
nav.is-red .navcta{border-color:rgba(255,255,255,.6)}
nav.is-red .navcta:hover{background:#fff;border-color:#fff;color:var(--red)}
nav .shell{max-width:none;display:flex;align-items:center;gap:2.6rem;padding:.85rem clamp(1.25rem,3vw,2.8rem)}
.nav-logo img{height:50px;width:auto;transition:opacity .2s}
.nav-logo:hover img{opacity:.82}
@media(max-width:560px){.nav-logo img{height:38px}}
.navlinks{display:flex;gap:1.9rem;align-items:center;font-size:.84rem;color:rgba(237,231,229,.72)}
.navlogin{margin-left:auto;font-size:.84rem;color:rgba(237,231,229,.72);position:relative;padding-bottom:2px;transition:color .2s}
.navlogin:hover{color:#fff}
.navlogin::after{content:'';position:absolute;left:0;right:0;bottom:-2px;height:1px;background:var(--red-lift);transform:scaleX(0);transform-origin:right;transition:transform .42s var(--ease)}
.navlogin:hover::after{transform:scaleX(1);transform-origin:left}
nav.is-red .navlogin::after{background:#fff}
.navlinks a{transition:color .2s}.navlinks a:hover{color:#fff}
.navcta{margin-left:1.5rem;background:transparent;color:#fff;border:1px solid rgba(255,255,255,.34);padding:.6rem 1.2rem;font-size:.68rem;font-weight:600;letter-spacing:.11em;text-transform:uppercase;border-radius:2px;transition:background .28s var(--ease),border-color .28s var(--ease),color .28s var(--ease)}
.navcta:hover{background:var(--red);border-color:var(--red);color:#fff}
/* sliding underline on the nav links (fluid-tab technique, no JS) */
.navlinks a{position:relative;padding-bottom:2px}
.navlinks a::after{content:'';position:absolute;left:0;right:0;bottom:-2px;height:1px;background:var(--red-lift);transform:scaleX(0);transform-origin:right;transition:transform .42s var(--ease)}
.navlinks a:hover::after{transform:scaleX(1);transform-origin:left}
@media(max-width:820px){.navlinks,.navlogin{display:none}}

/* ── HERO (dark, brand mark) ── */
.hero{background:var(--void);color:#fff;position:relative;overflow:hidden;min-height:calc(100svh - 104px);display:flex;flex-direction:column}
.hero .shell{position:relative;z-index:3;max-width:none;margin:0;width:100%;padding-left:clamp(1.25rem,3vw,2.8rem);padding-right:clamp(1.25rem,3vw,2.8rem);padding-bottom:clamp(1.6rem,2.6vw,2.2rem);
  flex:1;display:flex;flex-direction:column;justify-content:flex-start;padding-top:calc(clamp(2rem,5vh,4rem) + 82px);padding-bottom:clamp(1.2rem,3vh,2.6rem)}
.hcopy{max-width:none}
h1{font-family:var(--display);font-weight:700;font-size:clamp(2.7rem,9.5vw,8.4rem);line-height:.92;letter-spacing:-.042em;margin-top:0;color:#fff;text-wrap:nowrap}
h1 em{font-style:normal;color:var(--red-lift)}
.hero .lbl{color:rgba(255,255,255,.5)}
.hero .lbl::before{color:var(--red-lift)}
.hero .sub{font-size:clamp(.98rem,1.25vw,1.09rem);margin-top:1.5rem;max-width:52ch;color:rgba(237,231,229,.72)}
.ctas{display:flex;gap:.75rem;flex-wrap:wrap;margin-top:1.8rem}
.hero .btn-a{background:var(--red);color:#fff}.hero .btn-a:hover{background:var(--red-lift);transform:translateY(-2px)}
.hero .btn-b{border-color:rgba(255,255,255,.4);color:#fff}.hero .btn-b:hover{border-color:#fff;transform:translateY(-2px)}
.reassure{margin-top:1rem;font-size:.77rem;color:rgba(237,231,229,.5)}

/* three disciplines, so the whole offer is visible in the first screen */
.disciplines{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;margin-top:2.4rem;
  border-top:1px solid rgba(255,255,255,.13);max-width:760px}
.disciplines a{position:relative;display:block;padding:1.05rem 1.1rem 1.05rem 0;transition:color .25s var(--ease)}
.disciplines a+a{padding-left:1.3rem}
.disciplines a+a::before{content:'';position:absolute;left:0;top:.95rem;bottom:.95rem;width:1px;background:rgba(255,255,255,.13)}
.disciplines b{display:block;font-size:.83rem;font-weight:600;color:rgba(237,231,229,.94);letter-spacing:-.005em;transition:color .25s var(--ease)}
.disciplines i{display:block;font-style:normal;font-size:.72rem;line-height:1.45;color:rgba(237,231,229,.5);margin-top:.22rem;transition:color .25s var(--ease)}
.disciplines a::after{content:'';position:absolute;left:0;right:1.1rem;bottom:0;height:1px;background:var(--red-lift);transform:scaleX(0);transform-origin:right;transition:transform .45s var(--ease)}
.disciplines a:hover::after{transform:scaleX(1);transform-origin:left}
.disciplines a:hover b{color:#fff}
.disciplines a:hover i{color:rgba(237,231,229,.75)}
@media(max-width:640px){
  .disciplines{grid-template-columns:1fr}
  .disciplines a,.disciplines a+a{padding:.85rem 0}
  .disciplines a+a::before{left:0;right:auto;top:0;bottom:auto;width:100%;height:1px}
}

/* scrim so a massive mark never costs the headline its legibility */
.hero::after{content:'';position:absolute;inset:0;z-index:2;pointer-events:none;
  background:linear-gradient(100deg,var(--void) 6%,rgba(12,10,9,.95) 34%,rgba(12,10,9,.78) 52%,rgba(12,10,9,.34) 70%,transparent 88%)}

/* crosshair — you are aiming at the mark */
.xhair{position:absolute;inset:0;z-index:4;pointer-events:none;opacity:0;transition:opacity .5s var(--ease)}
.xhair.live{opacity:1}
.xhair i{position:absolute;background:linear-gradient(var(--xdir),transparent,rgba(210,66,52,.42) 22%,rgba(210,66,52,.42) 78%,transparent)}
.xhair .xh{left:0;right:0;height:1px;--xdir:90deg}
.xhair .xv{top:0;bottom:0;width:1px;--xdir:180deg}
.xhair .xdot{position:absolute;width:34px;height:34px;margin:-17px 0 0 -17px;border:1px solid rgba(210,66,52,.55);border-radius:50%}
.xhair .xdot::after{content:'';position:absolute;inset:14px;border-radius:50%;background:rgba(210,66,52,.9)}
@media(hover:none),(prefers-reduced-motion:reduce){.xhair{display:none}}

/* the brand mark, at architectural scale */
.mark{position:absolute;right:-11%;top:50%;transform:translateY(-50%);width:min(1120px,70vw);aspect-ratio:1;pointer-events:none;z-index:1;opacity:.5}
.mark svg{width:100%;height:100%;overflow:visible}
.mark .st3{fill:var(--red-lift)}
.mark .st4{fill:#0C0A09;opacity:.32}
.mark::before{content:'';position:absolute;left:47%;top:53%;width:92%;aspect-ratio:1;transform:translate(-50%,-50%);border-radius:50%;
  background:radial-gradient(circle,rgba(210,66,52,.40) 0%,rgba(200,50,38,.20) 34%,rgba(176,39,28,.07) 56%,transparent 72%);
  opacity:0;animation:glowIn 2.4s var(--ease) 3.4s forwards}
/* once it has arrived, the glow breathes */
.mark.go::after{content:'';position:absolute;left:47%;top:53%;width:92%;aspect-ratio:1;transform:translate(-50%,-50%);border-radius:50%;
  background:radial-gradient(circle,rgba(210,66,52,.30) 0%,rgba(176,39,28,.10) 42%,transparent 70%);
  opacity:0;animation:glowPulse 6s ease-in-out 6.2s infinite}
@keyframes glowIn{to{opacity:1}}
@keyframes glowPulse{0%,100%{opacity:.25;transform:translate(-50%,-50%) scale(.94)}50%{opacity:.85;transform:translate(-50%,-50%) scale(1.06)}}
@media(prefers-reduced-motion:reduce){.mark::before{animation:none;opacity:1}.mark.go::after{animation:none;opacity:.4}}

#ringOuter,#ringInner{transform-box:view-box;transform-origin:947px 1057px;opacity:0}
.mark.go #ringOuter{animation:ringIn 2.2s var(--springy) 3.4s both}
.mark.go #ringInner{animation:ringIn 2.2s var(--springy) 3.7s both}
@keyframes ringIn{from{opacity:0;transform:scale(.68)}to{opacity:1;transform:scale(1)}}
#arrow{transform-box:view-box;transform-origin:947px 1057px;opacity:0}
.mark.go #arrow{animation:arrowIn 2s var(--spring) 4.4s both}
@keyframes arrowIn{0%{opacity:0;transform:translate(620px,-620px)}35%{opacity:1}100%{opacity:1;transform:translate(0,0)}}
#shadows{opacity:0}
.mark.go #shadows{animation:fadeIn 1.1s var(--ease) 5.4s both}
@keyframes fadeIn{to{opacity:1}}
#impact{transform-box:view-box;transform-origin:947px 1057px;opacity:0;fill:none;stroke:var(--red-lift);stroke-width:14}
.mark.go #impact{animation:impact 1.9s var(--ease) 5.31s forwards}
@keyframes impact{0%{opacity:.85;transform:scale(.12)}100%{opacity:0;transform:scale(1.05)}}

/* Sequence, on load and never gated behind an observer:
   label wipes in, then each headline line left-to-right, then the mark, then the stats. */
h1 .ln{display:block}
.hcopy .lbl,h1 .ln{animation:wipeIn 2s var(--ease) both}
.hcopy .lbl{animation-duration:.85s;animation-delay:.15s}
h1 .ln:nth-child(1){animation-delay:.7s}
h1 .ln:nth-child(2){animation-delay:1.9s}
@keyframes wipeIn{
  0%{opacity:0;clip-path:inset(0 100% 0 0);filter:blur(9px);transform:translateY(12px)}
  55%{opacity:1}
  100%{opacity:1;clip-path:inset(0 -.12em 0 0);filter:blur(0);transform:none}
}

@media(max-width:980px){.mark{right:-16%;width:min(600px,70vw);opacity:.42}}
@media(max-width:820px){
  .mark{right:-34%;top:60%;width:min(680px,116vw);opacity:.16}
  .hero .shell{min-height:auto}
  .disciplines{gap:0 1.1rem}
}
@media(prefers-reduced-motion:reduce){
  .mark.go #ringOuter,.mark.go #ringInner,.mark.go #arrow,.mark.go #shadows,.hcopy>*{animation:none;opacity:1;transform:none;filter:none}
  .mark.go #impact{animation:none;opacity:0}
}

/* VIDEO + testimonials, side by side */
.videosec .wide{max-width:none;padding:0 clamp(1.25rem,3vw,2.8rem)}
.vgrid{display:grid;grid-template-columns:1.32fr .68fr;gap:clamp(1.4rem,2.6vw,2.6rem);align-items:stretch;
  padding-top:0;padding-bottom:clamp(3rem,6vw,5rem)}
@media(max-width:940px){.vgrid{grid-template-columns:1fr;gap:1.8rem}}
.vside{display:flex;flex-direction:column;justify-content:center;padding:clamp(1.4rem,3vw,2.6rem) 0}
.vside .lbl{color:rgba(237,231,229,.5);margin-bottom:1rem}
.vside .lbl::before{color:var(--red-lift)}
.vside .carousel{border:none;background:transparent;border-radius:0;flex:1;display:flex;align-items:center}
.vside .qmark{top:-.28em;left:-.06em}
.vside .navpill{margin-top:.4rem}
.vside .slide{padding:0}
.vside .slide blockquote{font-size:clamp(1rem,1.5vw,1.24rem)}

/* legacy single-column treatment kept for reference */
.videosec{background:var(--void);border-bottom:none}
.videosec .shell{padding-top:clamp(3.4rem,6.5vw,5.4rem);padding-bottom:clamp(3.4rem,6.5vw,5.4rem)}
.videosec .shead{margin-bottom:clamp(1.6rem,3vw,2.4rem);max-width:60ch}
.videosec .shead h2{color:#fff}
.videosec .shead p{color:rgba(237,231,229,.66)}
.videosec .morelink{color:rgba(237,231,229,.72)}
.videosec .morelink:hover{color:#fff}
/* the frame and the carousel share an edge, so the quotes read as coming out of the video */
.videoframe{position:relative;aspect-ratio:16/9;overflow:hidden;background:#000;
  border:1px solid rgba(255,255,255,.13);border-bottom:none;border-radius:3px 3px 0 0}
.videosec .carousel{border-top:none;border-radius:0 0 3px 3px;margin-top:0}
@media(max-width:920px){.videoframe{aspect-ratio:16/10}}
.videoframe>img{width:100%;height:100%;object-fit:cover;object-position:center 38%;filter:saturate(.82);transition:transform 1.1s var(--ease)}
.videoframe:hover>img{transform:scale(1.03)}
.videoframe .grad{position:absolute;inset:0;background:linear-gradient(180deg,rgba(12,10,9,.26) 0%,rgba(12,10,9,.3) 40%,rgba(12,10,9,.94) 100%)}
.playwrap{position:absolute;inset:0;display:flex;align-items:center;justify-content:center}
.playbtn{width:72px;height:72px;border-radius:50%;border:1.5px solid rgba(255,255,255,.55);display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,.07);transition:background .25s var(--ease),border-color .25s,transform .25s var(--ease)}
.videoframe:hover .playbtn{background:rgba(255,255,255,.17);border-color:#fff;transform:scale(1.07)}
.videocap{position:absolute;left:0;right:0;bottom:0;padding:1.45rem;color:#fff;z-index:2}
.videocap .who{font-size:.64rem;letter-spacing:.17em;text-transform:uppercase;color:rgba(255,255,255,.6);font-weight:600}
.videocap .what{font-family:var(--display);font-size:1.02rem;font-weight:700;margin-top:.28rem;line-height:1.33;color:#fff}

/* ── GOLD TICKER (kept from original) ── */
.tickerband{border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:1.15rem 0;background:var(--sunk)}
.tickerwrap{overflow:hidden;-webkit-mask-image:linear-gradient(to right,transparent 0%,#000 9%,#000 91%,transparent 100%);mask-image:linear-gradient(to right,transparent 0%,#000 9%,#000 91%,transparent 100%)}
.tickertrack{display:flex;align-items:center;width:max-content;animation:ticker 46s linear infinite;will-change:transform}
.tickertrack{animation-duration:46s}
.tickerband:hover .tickertrack{animation-duration:150s}
.tickeritem{font-size:.755rem;font-weight:600;letter-spacing:.23em;text-transform:uppercase;color:var(--gold-deep);white-space:nowrap;padding:0 1.9rem}
.tickeritem b{color:var(--red);font-weight:700}
.tickersep{font-size:.42rem;color:rgba(154,124,34,.45);flex-shrink:0}
@keyframes ticker{0%{transform:translate3d(0,0,0)}100%{transform:translate3d(-50%,0,0)}}

/* ══ CONTACT: fewer words beside the form, tighter fields ══ */
.capside{max-width:34ch}
.capside .lead{margin-top:1rem;font-size:.98rem;line-height:1.6}
.capside .phonebox{display:inline-flex;flex-direction:column;gap:.2rem;margin-top:1.9rem;padding:1rem 1.3rem;
  border:1px solid rgba(255,255,255,.18);border-radius:3px;transition:border-color .3s var(--ease),background .3s var(--ease)}
.capside .phonebox:hover{border-color:rgba(255,255,255,.5);background:rgba(255,255,255,.04)}
.capside .pl{font-size:.68rem;letter-spacing:.16em;text-transform:uppercase;color:rgba(237,231,229,.5)}
.capside .pn{font-family:var(--display);font-size:1.24rem;font-weight:700;color:#fff;letter-spacing:-.01em}
.bookcard .ff{margin-bottom:.9rem}
.bookcard .frow{display:grid;grid-template-columns:1fr 1fr;gap:.9rem}
@media(max-width:560px){.bookcard .frow{grid-template-columns:1fr}}
.bookcard .fl{display:block;font-size:.7rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:.4rem}
.bookcard .fl em{font-style:normal;text-transform:none;letter-spacing:.02em;font-weight:400}
.bookcard .fi{width:100%;padding:.82rem .9rem;font:inherit;font-size:.92rem;color:var(--ink);background:var(--surface);
  border:1px solid var(--line);border-radius:3px;transition:border-color .25s var(--ease),box-shadow .25s var(--ease)}
.bookcard .fi:focus{outline:none;border-color:var(--red);box-shadow:0 0 0 3px rgba(176,39,28,.12)}
.bookcard .fradio{display:flex;gap:.6rem}
.bookcard .fradio label{flex:1;display:flex;align-items:center;justify-content:center;gap:.45rem;padding:.72rem .6rem;
  border:1px solid var(--line);border-radius:3px;font-size:.86rem;cursor:pointer;transition:border-color .25s var(--ease),background .25s}
.bookcard .fradio label:hover{border-color:var(--ink)}
.bookcard .fsub{margin-top:.4rem}
.bookcard .fnote{margin-top:.7rem;font-size:.73rem;color:var(--muted);text-align:center}

/* ══ TESTIMONIALS, standing on their own ══ */
.tsec{background:var(--void);border-bottom:none}
.tsec .wide{max-width:none;padding:0 clamp(1.25rem,3vw,2.8rem)}
.tsec .shead h2{color:#fff}
.tsec .lbl{color:rgba(237,231,229,.5)}
.tsec .lbl::before{color:var(--red-lift)}
.tsec .morelink{color:rgba(237,231,229,.72)}
.tsec .morelink:hover{color:#fff}
.tgrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;background:rgba(255,255,255,.13);
  border-top:1px solid rgba(255,255,255,.13);border-bottom:1px solid rgba(255,255,255,.13)}
@media(max-width:860px){.tgrid{grid-template-columns:1fr}}
.tq{margin:0;background:var(--void);padding:clamp(1.8rem,3.4vw,3.2rem);display:flex;flex-direction:column;justify-content:space-between}
.tq blockquote{margin:0;font-family:var(--display);font-weight:400;
  font-size:clamp(1.05rem,1.75vw,1.42rem);line-height:1.5;letter-spacing:-.012em;color:#F6F2F0}
.tq blockquote::before{content:'\201C';display:block;font-size:2.6em;line-height:.5;color:rgba(210,66,52,.42);margin-bottom:.28em}
.tq figcaption{margin-top:1.6rem;display:flex;align-items:center;gap:.6rem;font-size:.76rem;letter-spacing:.05em;color:rgba(237,231,229,.55)}
.tq figcaption::before{content:'\25C6';color:var(--red-lift);font-size:.7rem}

/* programme panels: a centred mark in place of a photograph */
.phmark{background:var(--void);display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden}
.phmark::before{content:'';position:absolute;left:50%;top:50%;width:118%;aspect-ratio:1;transform:translate(-50%,-50%);
  border-radius:50%;background:radial-gradient(circle,rgba(176,39,28,.30) 0%,rgba(176,39,28,.09) 45%,transparent 70%)}
.gmark{position:relative;text-align:center;padding:1.4rem}
.gg{display:block;font-family:var(--display);font-weight:700;line-height:.94;letter-spacing:-.035em;color:var(--red-lift)}
.gs{display:block;margin-top:.7rem;font-size:.66rem;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:rgba(237,231,229,.5)}
.offer:hover .gg{transform:scale(1.04)}
.gg{transition:transform .6s var(--ease)}

/* ══ DIAGNOSTIC: scrollable gallery of the report's real charts ══ */
.dxscroll-wrap{position:relative;margin-top:clamp(1.8rem,3.4vw,2.8rem)}
.dxscroll{display:flex;gap:clamp(1rem,1.8vw,1.6rem);overflow-x:auto;scroll-snap-type:x mandatory;
  padding:.4rem .3rem 1.4rem;margin:0 -.3rem;scrollbar-width:thin;scrollbar-color:var(--line) transparent}
.dxscroll::-webkit-scrollbar{height:6px}
.dxscroll::-webkit-scrollbar-thumb{background:var(--line);border-radius:3px}
.dxpanel{flex:0 0 clamp(290px,44vw,540px);scroll-snap-align:start;border:1px solid var(--line);border-radius:4px;
  background:var(--surface);padding:clamp(1.2rem,2.2vw,1.8rem);display:flex;flex-direction:column;
  transition:border-color .35s var(--ease),transform .45s var(--ease)}
.dxpanel:hover{border-color:rgba(17,17,17,.28)}
.dxpanel .pk{font-size:.63rem;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:var(--red)}
.dxpanel h3{font-family:var(--display);font-weight:700;font-size:1.16rem;letter-spacing:-.015em;margin:.5rem 0 0}
.dxpanel .pcap{font-size:.79rem;line-height:1.55;color:var(--body);margin-top:.5rem}
.dxplot{margin-top:1.1rem;position:relative}
.dxplot svg{width:100%;height:auto;display:block;overflow:visible}
.dxfootnote{margin-top:.9rem;font-size:.7rem;color:var(--muted);line-height:1.5;border-top:1px solid var(--hair);padding-top:.7rem}
/* shared tooltip */
.dxtip{position:absolute;pointer-events:none;background:var(--void);color:#fff;font-size:.72rem;line-height:1.4;
  padding:.5rem .65rem;border-radius:3px;white-space:nowrap;opacity:0;transform:translate(-50%,-118%);
  transition:opacity .18s var(--ease);z-index:5;box-shadow:0 6px 18px rgba(0,0,0,.28)}
.dxtip.on{opacity:1}
.dxtip b{color:var(--red-lift)}
/* interactive marks */
.hitmark{cursor:pointer;transition:opacity .2s var(--ease)}
.dxpanel:hover .hitmark{opacity:.62}
.hitmark:hover,.hitmark:focus-visible{opacity:1!important;outline:none}
.dxlegend{display:flex;flex-wrap:wrap;gap:.5rem 1.1rem;margin-top:.9rem;font-size:.71rem;color:var(--body)}
.dxlegend span{display:flex;align-items:center;gap:.4rem}
.dxlegend i{width:9px;height:9px;border-radius:2px;flex:none}
.dxnav{display:flex;gap:.5rem;margin-top:.2rem}
.dxnav button{width:38px;height:38px;border-radius:50%;border:1px solid var(--line);background:var(--surface);cursor:pointer;
  display:flex;align-items:center;justify-content:center;color:var(--ink);transition:background .28s var(--ease),color .28s,border-color .28s,opacity .28s}
.dxnav button:hover{background:var(--void);color:#fff;border-color:var(--void)}
.dxnav button[disabled]{opacity:.3;cursor:default}
.dxnav button[disabled]:hover{background:var(--surface);color:var(--ink);border-color:var(--line)}
.dxtoggle{display:inline-flex;gap:.3rem;margin-top:.9rem;border:1px solid var(--line);border-radius:99px;padding:.2rem}
.dxtoggle button{border:none;background:transparent;font:inherit;font-size:.7rem;font-weight:600;letter-spacing:.04em;
  padding:.34rem .8rem;border-radius:99px;cursor:pointer;color:var(--muted);transition:background .3s var(--ease),color .3s}
.dxtoggle button[aria-pressed="true"]{background:var(--void);color:#fff}

/* ── PROOF ── */
.proof{background:var(--void);color:#EDE7E5;border-top:1px solid rgba(255,255,255,.10)}
@keyframes statRise{from{opacity:0;transform:translateY(34px);filter:blur(12px)}to{opacity:1;transform:none;filter:none}}
/* three tiles across the bottom of the first screen */
.tiles{position:relative;z-index:3;padding:0 clamp(1.25rem,3vw,2.8rem) clamp(1.6rem,4vh,3rem)}
.tiles .disciplines{max-width:none;margin-top:0}
.tiles .disciplines a{padding:clamp(1.2rem,2.4vh,1.9rem) 1.4rem clamp(1.2rem,2.4vh,1.9rem) 0}
.tiles .disciplines a+a{padding-left:1.6rem}
.tiles .disciplines b{font-size:clamp(.95rem,1.25vw,1.12rem)}
.tiles .disciplines i{font-size:clamp(.76rem,.92vw,.85rem);margin-top:.3rem}
.tiles .disciplines a{animation:statRise 1.9s var(--ease) both}
.tiles .disciplines a:nth-child(1){animation-delay:6s}
.tiles .disciplines a:nth-child(2){animation-delay:6.3s}
.tiles .disciplines a:nth-child(3){animation-delay:6.6s}
.proof .shell{max-width:none;padding:0 clamp(1.25rem,3vw,2.8rem);display:grid;grid-template-columns:repeat(4,1fr);gap:1px}
@media(max-width:820px){.proof .shell{grid-template-columns:repeat(2,1fr)}}
.pcell{padding:clamp(2.6rem,5vw,4.6rem) 1.4rem;position:relative}
.proof .shell{padding-top:0;padding-bottom:0}

.pcell+.pcell::before{content:"";position:absolute;left:0;top:24%;bottom:24%;width:1px;background:rgba(255,255,255,.12)}
.pcell .n{font-family:var(--display);font-weight:700;font-size:clamp(3.4rem,8.4vw,7.6rem);color:#fff;line-height:.98;letter-spacing:-.03em;font-variant-numeric:tabular-nums}
.pcell .n small{font-size:.5em;color:var(--red-lift)}
.pcell .c{font-size:.82rem;color:rgba(237,231,229,.6);margin-top:1.1rem;line-height:1.55;max-width:24ch}
.pcell .c b{color:#fff;font-weight:600;display:block;margin-bottom:.1rem}

section{padding:clamp(3.6rem,7vw,6.2rem) 0;border-bottom:1px solid var(--line)}
.shead{max-width:62ch;margin-bottom:clamp(1.9rem,3.8vw,2.9rem)}
.shead h2{font-family:var(--display);font-weight:700;font-size:clamp(1.6rem,3.1vw,2.4rem);line-height:1.14;margin-top:.7rem;letter-spacing:-.012em}
.shead p{margin-top:.95rem;font-size:.99rem;max-width:57ch}

/* springier interactive feel throughout */
.btn{transition:background .25s var(--ease),color .25s,border-color .25s,transform .35s var(--spring)}
.btn-a:hover,.btn-b:hover{transform:translateY(-2px)}
.btn-a:active,.btn-b:active{transform:translateY(0) scale(.985)}
.offer{transition:border-color .35s var(--ease),transform .45s var(--spring),box-shadow .45s var(--ease)}
.offer:hover{transform:translateY(-6px)}
.offer .ph img{transition:transform .8s var(--springy),filter .5s}
.offer:hover .ph img{transform:scale(1.06)}
.creds span{transition:border-color .3s,color .3s,transform .35s var(--spring)}
.creds span:hover{transform:translateY(-2px)}
.playbtn{transition:background .3s var(--ease),border-color .3s,transform .5s var(--spring)}
.videoframe:hover .playbtn{transform:scale(1.12)}
.fsub{transition:background .25s var(--ease),transform .35s var(--spring)}
.fsub:hover{transform:translateY(-2px)}
.fsub:active{transform:translateY(0) scale(.99)}


/* ── shimmer button ── */
.shimmer{position:relative;overflow:hidden;isolation:isolate}
.shimmer>span{position:relative;z-index:2}
.shimmer::after{content:"";position:absolute;inset:0;z-index:1;pointer-events:none;transform:translateX(-100%);
  background:linear-gradient(90deg,transparent 0%,rgba(255,255,255,.30) 50%,transparent 100%);
  transition:transform .7s var(--ease)}
.shimmer:hover::after,.shimmer:focus-visible::after{transform:translateX(100%)}
@media(prefers-reduced-motion:reduce){.shimmer::after{display:none}}


/* ── ALERT MODAL ── */
.modal{position:fixed;inset:0;z-index:200;display:flex;align-items:center;justify-content:center;padding:1.5rem}
.modal[hidden]{display:none}
.modal-back{position:absolute;inset:0;background:rgba(12,10,9,.62);backdrop-filter:blur(3px);animation:mFade .35s var(--ease) both}
.modal-card{position:relative;z-index:1;background:var(--surface);border-radius:16px;max-width:470px;width:100%;
  padding:clamp(1.8rem,4vw,2.5rem);box-shadow:0 30px 80px -30px rgba(12,10,9,.55);animation:mIn .5s var(--springy) both}
@keyframes mFade{from{opacity:0}to{opacity:1}}
@keyframes mIn{from{opacity:0;transform:translateY(20px) scale(.97)}to{opacity:1;transform:none}}
.modal-x{position:absolute;top:.9rem;right:.9rem;width:32px;height:32px;border:none;background:transparent;color:var(--muted);
  border-radius:50%;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background .2s,color .2s}
.modal-x:hover{background:var(--sunk);color:var(--ink)}
.modal-kicker{font-size:.6rem;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:var(--red)}
.modal-kicker::before{content:'\25C6';margin-right:.5em;font-size:.85em;letter-spacing:0}
.modal-card h2{font-family:var(--display);font-weight:700;font-size:clamp(1.4rem,3vw,1.85rem);margin:.6rem 0 .8rem;line-height:1.18}
.modal-card p{font-size:.92rem;line-height:1.6}
.modal-card p b{color:var(--ink);font-weight:600}
.modal-sub{margin-top:.7rem;font-size:.86rem;color:var(--muted)}
.modal-acts{display:flex;gap:.7rem;flex-wrap:wrap;margin-top:1.6rem}
.modal-acts .btn{padding:.9rem 1.4rem;font-size:.72rem}

/* ── DIAGNOSTIC ── */
.dxwrap{display:grid;grid-template-columns:1.08fr .92fr;gap:clamp(1.4rem,3.5vw,3rem);align-items:start}
@media(max-width:940px){.dxwrap{grid-template-columns:1fr}}
.dxcard{border:1px solid var(--line);border-radius:14px;background:var(--surface);padding:clamp(1.4rem,2.8vw,2.1rem);
  box-shadow:0 1px 2px rgba(17,17,17,.03),0 26px 56px -34px rgba(17,17,17,.4)}
.dxhead{display:flex;justify-content:space-between;align-items:baseline;border-bottom:2px solid var(--red);padding-bottom:.75rem;margin-bottom:1.4rem}
.dxt{font-family:var(--display);font-weight:700;font-size:1rem;color:var(--ink)}
.dxd{font-size:.64rem;letter-spacing:.16em;text-transform:uppercase;color:var(--muted)}
.dxscore{display:flex;gap:1.6rem;flex-wrap:wrap;align-items:flex-end;justify-content:space-between}
.dxbig{font-size:3.4rem;font-weight:700;color:var(--ink);line-height:1;font-variant-numeric:tabular-nums;letter-spacing:-.02em}
.dxrange{font-size:.79rem;color:var(--muted);margin-top:.4rem}
.dxrange b{color:var(--ink);font-weight:600}
.dxsplit{display:flex;gap:1.5rem}
.dxsplit>div{display:flex;flex-direction:column;gap:.15rem}
.dxn{font-size:1.15rem;font-weight:600;color:var(--ink);font-variant-numeric:tabular-nums}
.dxl{font-size:.63rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
.dxwhy{margin-top:1.9rem;padding-top:1.4rem;border-top:1px solid var(--hair)}
.dxwhy-h{font-size:.63rem;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);margin-bottom:.7rem}
.dxbar{display:flex;gap:3px;height:38px;border-radius:6px;overflow:hidden}
.dxbar i{display:flex;align-items:center;justify-content:center;border-radius:3px;transition:flex .6s var(--springy)}
.dxbar i span{font-size:.82rem;font-weight:700;color:#fff}
.dxbar .w1,.dxkey .w1{background:#B0271C}
.dxbar .w2,.dxkey .w2{background:#C9A84C}
.dxbar .w3,.dxkey .w3{background:#2E2724}
.dxkey{display:grid;gap:.42rem;margin-top:.85rem}
.dxkey span{display:flex;align-items:center;gap:.5rem;font-size:.78rem;color:var(--body)}
.dxkey i{width:9px;height:9px;border-radius:2px;flex:none}
.dxfoot{margin-top:1.2rem;font-size:.8rem;color:var(--muted);font-style:italic}
.dxread{display:grid;gap:0}
.dxr{display:grid;grid-template-columns:1.6rem 1fr;gap:.9rem;padding:1.05rem 0;border-bottom:1px solid var(--hair)}
.dxr:last-child{border-bottom:none}
.dxi{font-family:Georgia,'Times New Roman',serif;font-style:italic;font-weight:700;color:var(--red);font-size:1.05rem}
.dxr h3{font-size:.94rem;font-weight:600;margin-bottom:.2rem}
.dxr p{font-size:.86rem}

/* ── PROGRAMS ── */
.offers{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(1rem,2vw,1.5rem)}
@media(max-width:900px){.offers{grid-template-columns:1fr}}
.offer{display:flex;flex-direction:column;background:var(--surface);border:1px solid var(--line);border-radius:3px;overflow:hidden;transition:border-color .3s var(--ease),transform .3s var(--ease),box-shadow .3s var(--ease)}
.offer:hover{border-color:rgba(17,17,17,.28);transform:translateY(-4px);box-shadow:0 26px 46px -34px rgba(17,17,17,.55)}
.offer .ph{aspect-ratio:16/10;overflow:hidden;background:var(--void)}
.offer .ph img{width:100%;height:100%;object-fit:cover;filter:saturate(.82) brightness(.9);transition:transform .7s var(--ease),filter .5s}
.offer:hover .ph img{transform:scale(1.045);filter:saturate(.95) brightness(1)}
.offer .in{padding:1.3rem 1.35rem 1.45rem;display:flex;flex-direction:column;flex:1}
.offer .k{font-size:.585rem;font-weight:600;letter-spacing:.19em;text-transform:uppercase;color:var(--red)}
.offer h3{font-family:var(--display);font-weight:700;font-size:1.28rem;margin:.48rem 0 .55rem;line-height:1.2}
.offer p{font-size:.855rem;flex:1}
.offer .cov{margin-top:.95rem;padding-top:.85rem;border-top:1px solid var(--hair);font-size:.735rem;color:var(--muted);line-height:1.5}
.offer .go{margin-top:1.1rem;font-size:.71rem;font-weight:600;letter-spacing:.11em;text-transform:uppercase;color:var(--ink);display:inline-flex;gap:.4rem;align-items:center;transition:gap .25s var(--ease),color .2s}
.offer:hover .go{color:var(--red);gap:.7rem}

/* ── METHOD ── */
.method{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);border:1px solid var(--line);border-radius:3px;overflow:hidden}
@media(max-width:860px){.method{grid-template-columns:repeat(2,1fr)}}
.mstep{background:var(--surface);padding:clamp(1.25rem,2.2vw,1.8rem);transition:background .3s}
.mstep:hover{background:var(--sunk)}
.mstep .k{font-family:Georgia,'Times New Roman',serif;font-style:italic;font-weight:700;font-size:1.05rem;color:var(--red)}
.mstep h3{font-size:.99rem;font-weight:600;margin:.42rem 0 .38rem}
.mstep p{font-size:.835rem}


/* ── INSTRUCTOR ── */
.instr{display:grid;grid-template-columns:.82fr 1.18fr;gap:clamp(1.8rem,4.2vw,3.4rem);align-items:center}
@media(max-width:900px){.instr{grid-template-columns:1fr}}
.instr .pic{position:relative;aspect-ratio:1/1;overflow:hidden;border-radius:3px;background:var(--void)}
.instr .pic img{width:100%;height:100%;object-fit:cover;object-position:center 20%;filter:grayscale(.18) contrast(1.04)}
.creds{display:flex;flex-wrap:wrap;gap:.45rem;margin-top:1.35rem}
.creds span{font-size:.7rem;border:1px solid var(--line);padding:.4rem .78rem;color:var(--body);border-radius:2px;transition:border-color .22s,color .22s}
.creds span:hover{border-color:var(--ink);color:var(--ink)}
.gbox{margin-top:1.9rem;border-left:3px solid var(--red);padding:1.05rem 0 1.05rem 1.25rem;background:linear-gradient(90deg,rgba(176,39,28,.045),transparent 65%)}
.gbox .k{font-size:.605rem;font-weight:600;letter-spacing:.21em;text-transform:uppercase;color:var(--red)}
.gbox h3{font-family:var(--display);font-size:clamp(1.18rem,2.2vw,1.5rem);font-weight:700;margin:.5rem 0 .55rem;line-height:1.22}
.gbox p{font-size:.885rem}

/* ── TIMING ── */
.scroller{overflow-x:auto;border:1px solid var(--line);border-radius:3px;background:var(--surface)}
table.dates{border-collapse:collapse;width:100%;min-width:600px;font-size:.885rem}
table.dates th,table.dates td{text-align:left;padding:.92rem 1.1rem;border-bottom:1px solid var(--hair)}
table.dates thead th{font-size:.585rem;font-weight:600;letter-spacing:.17em;text-transform:uppercase;color:var(--muted);background:var(--sunk);border-bottom:1px solid var(--line);white-space:nowrap}
table.dates tbody tr{transition:background .22s}
table.dates tbody tr:hover{background:var(--sunk)}
table.dates tbody tr:last-child td{border-bottom:none}
table.dates td.dt{font-family:var(--display);font-weight:700;color:var(--ink);white-space:nowrap}
table.dates td.st{color:var(--muted);font-size:.78rem;white-space:nowrap}
table.dates tr.soon{background:rgba(176,39,28,.04)}
table.dates tr.soon td.st{color:var(--red);font-weight:600}
table.dates b{color:var(--red);font-weight:600}


/* ── RESULTS ── */
.results{background:var(--void);border-bottom:none}
.results .lbl{color:rgba(237,231,229,.5)}
.results .lbl::before{color:var(--red-lift)}
.results .shead h2{color:#fff}
.carousel{position:relative;border:1px solid rgba(255,255,255,.13);border-radius:3px;background:rgba(255,255,255,.028);overflow:hidden}
.qmark{position:absolute;top:-.35em;left:.12em;font-family:var(--display);font-size:clamp(7rem,15vw,11rem);line-height:1;color:rgba(176,39,28,.22);pointer-events:none;user-select:none}
.slides{display:grid;position:relative;z-index:1}
.slide{grid-area:1/1;padding:clamp(2rem,4.2vw,3.4rem) clamp(1.6rem,4vw,3.4rem) clamp(1.4rem,2.6vw,2rem);display:flex;flex-direction:column;justify-content:center;opacity:0;transform:translateY(14px);pointer-events:none;transition:opacity .65s var(--ease),transform .65s var(--ease)}
.slide.on{opacity:1;transform:none;pointer-events:auto}
.slide blockquote{margin:0;font-family:var(--display);font-size:clamp(1.06rem,1.95vw,1.45rem);line-height:1.55;color:#F6F2F0;max-width:64ch}
.tgain{color:var(--gold);font-weight:700;white-space:nowrap}
.slide .attr{margin-top:1.6rem;display:flex;align-items:center;gap:.65rem;font-size:.78rem;color:rgba(237,231,229,.6);letter-spacing:.03em}
.slide .attr::before{content:'\25C6';color:var(--red-lift);font-size:.72rem}

/* ── CAROUSEL NAVIGATOR (Watermelon pattern, brand palette) ── */
.inds{display:flex;align-items:center;gap:.5rem;padding:0 .6rem}
.ind{position:relative;height:12px;width:12px;border:none;padding:0;cursor:pointer;overflow:hidden;border-radius:24px;
  background:rgba(255,255,255,.3);transition:width .45s cubic-bezier(.2,1.2,.35,1),background .3s var(--ease)}
.ind.on{width:48px;background:rgba(255,255,255,.28)}
.ind i{position:absolute;inset:0;width:0;border-radius:24px;background:#fff;box-shadow:0 0 8px rgba(255,255,255,.5);display:block}
.ind.on i.run{animation:cfill linear forwards}
@keyframes cfill{from{width:0}to{width:100%}}
@media(prefers-reduced-motion:reduce){.ind i.run{animation:none;width:100%}}
.navpill{display:inline-flex;align-items:center;gap:.25rem;padding:.55rem .7rem;border-radius:100px;background:rgba(255,255,255,.055);border:1px solid rgba(255,255,255,.1);margin:0 clamp(1.6rem,4vw,3.4rem) clamp(1.5rem,3vw,2.2rem);transition:background .3s var(--ease),border-color .3s var(--ease)}
.narw{width:44px;height:44px;border-radius:50%;border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;background:var(--red);color:#fff;box-shadow:0 1px 3px rgba(0,0,0,.25);transition:background .3s var(--ease),transform .28s var(--spring),opacity .3s}
.narw:hover{background:var(--red-lift)}
.narw:active{transform:scale(.9)}
.narw[disabled]{background:rgba(255,255,255,.12);color:rgba(255,255,255,.35);cursor:default;opacity:.55}
.narw[disabled]:active{transform:none}
.ind{position:relative;height:12px;width:12px;border:none;padding:0;cursor:pointer;border-radius:24px;background:rgba(255,255,255,.26);overflow:hidden;
     transition:width .45s cubic-bezier(.3,1.3,.5,1),background .3s var(--ease)}
.morelink{color:#fff;border-bottom:1px solid rgba(255,255,255,.3);padding-bottom:2px}
.morelink:hover{border-bottom-color:#fff}

/* ── RESERVE ── */
.capture{background:var(--void);color:#EDE7E5;border-bottom:none}
.capture .shell{display:grid;grid-template-columns:.95fr 1.05fr;gap:clamp(2rem,4.5vw,3.6rem);align-items:start;padding-top:clamp(3.4rem,6.5vw,5.5rem);padding-bottom:clamp(3.4rem,6.5vw,5.5rem)}
@media(max-width:900px){.capture .shell{grid-template-columns:1fr}}
.capture .lbl{color:rgba(237,231,229,.5)!important}
.capture .lbl::before{color:var(--red-lift)}
.capture h2{font-family:var(--display);font-size:clamp(1.75rem,3.4vw,2.5rem);color:#fff;line-height:1.14;margin-top:.7rem}
.capture .lead{margin-top:1rem;font-size:.98rem;max-width:42ch;color:rgba(237,231,229,.72)}
.enroll{list-style:none;padding:0;margin:1.9rem 0 0;display:flex;flex-wrap:wrap;gap:.5rem 1.4rem}
.enroll li{display:flex;align-items:center;gap:.55rem;font-size:.82rem;color:rgba(237,231,229,.9);font-weight:500}
.enroll li span{width:20px;height:20px;border-radius:50%;background:var(--red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:.65rem;font-weight:600;flex:none}
.phonebox{margin-top:2rem;padding-top:1.4rem;border-top:1px solid rgba(255,255,255,.15)}
.phonebox .pl{display:block;font-size:.68rem;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:rgba(237,231,229,.5)}
.phonebox .pn{display:inline-block;margin-top:.4rem;font-family:Georgia,'Times New Roman',serif;font-style:italic;font-size:1.45rem;color:#fff}
.phonebox .pn:hover{color:var(--red-lift)}
.bookcard{background:var(--surface);border:1px solid var(--line);border-radius:3px;padding:clamp(1.5rem,2.8vw,2.1rem);box-shadow:0 1px 2px rgba(17,17,17,.03),0 22px 50px -34px rgba(17,17,17,.4)}
.hp-field{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
.ff{margin-bottom:.95rem}
.frow{display:grid;grid-template-columns:1fr 1fr;gap:.85rem}
@media(max-width:560px){.frow{grid-template-columns:1fr}}
.fl{display:block;font-size:.63rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin-bottom:.4rem}
.fl em{font-style:normal;font-weight:400;letter-spacing:.02em;text-transform:none;color:var(--muted)}
.fi{width:100%;padding:.82rem .9rem;background:var(--paper);border:1px solid var(--line);border-radius:2px;color:var(--ink);font-family:var(--sans);font-size:.9rem;font-weight:300;transition:border-color .2s,background .2s}
.fi:focus{outline:none;border-color:var(--red);background:#fff}
textarea.fi{resize:vertical;min-height:76px}
.fradio{display:flex;gap:1.4rem;padding-top:.15rem}
.fradio label{display:flex;align-items:center;gap:.45rem;font-size:.86rem;color:var(--ink);cursor:pointer}
.fradio input{accent-color:var(--red)}
.fsub{width:100%;margin-top:.4rem;padding:1.02rem;background:var(--red);color:#fff;border:none;border-radius:2px;font-family:var(--sans);font-size:.76rem;font-weight:600;letter-spacing:.11em;text-transform:uppercase;cursor:pointer;transition:background .22s var(--ease)}
.fsub:hover{background:var(--ink)}
.fsub:disabled{opacity:.6;cursor:default}
.fnote{margin-top:.7rem;font-size:.72rem;color:var(--muted);text-align:center}
.fmsg{display:none;margin-top:.7rem;font-size:.78rem;line-height:1.6}
.fmsg.ok{color:var(--gold-deep)}
.fmsg.err{color:var(--red)}

footer{background:var(--void);color:rgba(237,231,229,.48);font-size:.79rem;border-top:1px solid rgba(255,255,255,.08)}
footer .shell{display:flex;justify-content:space-between;gap:2rem;flex-wrap:wrap;padding-top:2.3rem;padding-bottom:2.3rem}
footer a{color:rgba(237,231,229,.7);transition:color .2s}footer a:hover{color:#fff}
.footer-phone{display:inline-block;font-style:italic;font-family:Georgia,'Times New Roman',serif;font-size:1.12rem;color:#fff!important;margin:.45rem 0 .65rem}
.footer-links a{margin-right:1rem;font-size:.75rem}
.footer-right{display:flex;align-items:center}
.footer-linkedin{display:inline-block;margin-top:.85rem;color:rgba(237,231,229,.55)}

@media (prefers-reduced-motion:reduce){
  *{transition:none!important;scroll-behavior:auto!important}
  .tickertrack,.repbars i,.newsbar .dot{animation:none!important}
  .js.anim .rv{opacity:1!important;transform:none!important;filter:none!important}
}
</style>
</head>
